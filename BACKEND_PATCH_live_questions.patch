+"""A deleted collection's questions must not be dealt to a student.
+
+Deleting a collection only retires the collection; its questions stay in the table, and every
+assessment still holds their ids. These tests pin the rule that keeps them from being dealt — for a
+new attempt, and for one that is already open.
+"""
+
+import asyncio
+import uuid
+
+from sqlalchemy.dialects import postgresql
+
+from app.services.attempt_questions import (
+    draw_question_ids,
+    live_question_ids,
+    prune_dead_questions,
+    top_up_questions,
+)
+
+
+def ids(prefix: str, n: int) -> list[str]:
+    return [f"{prefix}-{i}" for i in range(n)]
+
+
+POOL = ids("keep", 60) + ids("gone", 40)  # 100 ids; the last 40 came from a deleted collection
+LIVE = set(ids("keep", 60))
+
+
+# ── dealing a new attempt ────────────────────────────────────────────────────
+
+def test_a_deleted_collections_questions_are_never_dealt():
+    for _ in range(200):  # random sampling — one lucky draw proves nothing
+        dealt = draw_question_ids(POOL, 30, shuffle=True, live_ids=LIVE)
+        assert len(dealt) == 30
+        assert not any(q.startswith("gone") for q in dealt)
+
+
+def test_without_a_live_set_nothing_is_filtered():
+    """The old behaviour, for callers that have not been given one."""
+    seen = set()
+    for _ in range(200):
+        seen.update(draw_question_ids(POOL, 30, shuffle=True))
+    assert any(q.startswith("gone") for q in seen)
+
+
+def test_a_pool_that_ran_short_is_dealt_whole():
+    dealt = draw_question_ids(POOL, 80, shuffle=True, live_ids=LIVE)
+    assert sorted(dealt) == sorted(LIVE)  # 60 live questions, 80 asked for
+
+
+def test_a_pool_with_nothing_live_deals_nothing():
+    assert draw_question_ids(POOL, 30, shuffle=True, live_ids=set()) == []
+
+
+def test_a_fixed_paper_takes_its_first_live_questions_in_shuffled_order():
+    dealt = draw_question_ids(["gone-0", "keep-0", "keep-1", "keep-2"], 2, shuffle=False, live_ids=LIVE)
+    assert sorted(dealt) == ["keep-0", "keep-1"]
+
+
+def test_the_count_defaults_to_the_whole_pool():
+    assert len(draw_question_ids(ids("keep", 7), None, shuffle=True, live_ids=LIVE | set(ids("keep", 7)))) == 7
+
+
+def test_an_empty_or_missing_pool_deals_nothing():
+    assert draw_question_ids(None, 10, shuffle=True) == []
+    assert draw_question_ids([], 10, shuffle=False) == []
+
+
+# ── resuming an attempt that is already open ─────────────────────────────────
+
+def test_dead_questions_the_student_never_answered_are_dropped():
+    dealt = ["keep-0", "gone-0", "keep-1", "gone-1"]
+    assert prune_dead_questions(dealt, [], LIVE) == ["keep-0", "keep-1"]
+
+
+def test_a_dead_question_the_student_answered_stays():
+    dealt = ["keep-0", "gone-0", "gone-1"]
+    responses = [{"question_id": "gone-0", "answer": "B"}]
+    assert prune_dead_questions(dealt, responses, LIVE) == ["keep-0", "gone-0"]
+
+
+def test_a_dead_question_only_looked_at_is_dropped():
+    """A saved response with no answer — visited, or marked for review — is not an answer."""
+    dealt = ["keep-0", "gone-0"]
+    for blank in (None, "", []):
+        responses = [{"question_id": "gone-0", "answer": blank, "marked_for_review": True}]
+        assert prune_dead_questions(dealt, responses, LIVE) == ["keep-0"]
+
+
+def test_nothing_changes_when_nothing_is_dead():
+    dealt = ["keep-0", "keep-1", "keep-2"]
+    assert prune_dead_questions(dealt, [{"question_id": "keep-0", "answer": "A"}], LIVE) == dealt
+
+
+def test_responses_that_are_not_dicts_are_ignored():
+    assert prune_dead_questions(["keep-0", "gone-0"], ["junk", None, 3], LIVE) == ["keep-0"]
+
+
+def test_a_shrunk_attempt_is_topped_back_up_from_the_pool():
+    kept = ["keep-0", "keep-1"]
+    filled = top_up_questions(kept, POOL, LIVE, 5)
+    assert len(filled) == 5
+    assert filled[:2] == kept
+    assert len(set(filled)) == 5  # no question twice
+    assert not any(q.startswith("gone") for q in filled)
+
+
+def test_the_top_up_runs_out_when_the_pool_does():
+    live = {"keep-0", "keep-1", "keep-2"}
+    filled = top_up_questions(["keep-0"], ["keep-0", "keep-1", "keep-2", "gone-0"], live, 10)
+    assert sorted(filled) == ["keep-0", "keep-1", "keep-2"]
+
+
+def test_no_top_up_when_the_attempt_is_already_full():
+    kept = ["keep-0", "keep-1"]
+    assert top_up_questions(kept, POOL, LIVE, 2) == kept
+    assert top_up_questions(kept, POOL, LIVE, 1) == kept
+
+
+# ── the lookup that says which questions are live ───────────────────────────
+
+class _Result:
+    def __init__(self, rows):
+        self.rows = rows
+
+    def scalars(self):
+        return self
+
+    def all(self):
+        return self.rows
+
+
+class _FakeDb:
+    """Stands in for the session: records the statement it is asked to run."""
+
+    def __init__(self, rows):
+        self.rows = rows
+        self.statements = []
+
+    async def execute(self, stmt):
+        self.statements.append(stmt)
+        return _Result(self.rows)
+
+
+def test_ids_that_are_not_ids_never_reach_the_database():
+    db = _FakeDb([])
+    assert asyncio.run(live_question_ids(db, ["nope", "", None, "12345"])) == set()
+    assert db.statements == []
+
+
+def test_live_means_no_collection_or_an_active_one():
+    """The same test as the question bank's list: a question with no paper, or one whose paper is active."""
+    try:
+        import os
+
+        os.environ.setdefault("DATABASE_URL", "postgresql+asyncpg://u:p@localhost/db")
+        os.environ.setdefault("OPENAI_API_KEY", "x")
+        os.environ.setdefault("SECRET_KEY", "x")
+        import app.models.eval_paper  # noqa: F401  (the lookup imports these itself)
+        import app.models.eval_question  # noqa: F401
+    except ModuleNotFoundError:
+        return  # the database driver is not installed here; the rules above are what matter
+
+    live = uuid.uuid4()
+    db = _FakeDb([live])
+    got = asyncio.run(live_question_ids(db, [str(live), str(uuid.uuid4()), "junk"]))
+
+    assert got == {str(live)}  # returned as strings, the form the rest of the code compares
+    sql = str(db.statements[0].compile(dialect=postgresql.dialect()))
+    assert "LEFT OUTER JOIN eval_papers" in sql
+    assert "eval_questions.paper_id IS NULL" in sql
+    assert "eval_papers.is_active IS true" in sql
+
+
+# ═════════════════════════════════════════════════════════════════════════════
+# Live pools — questions added after the paper was made reach it
+# ═════════════════════════════════════════════════════════════════════════════
+
+import types
+
+from sqlalchemy import Boolean, Column, String
+from sqlalchemy.dialects.postgresql import UUID
+from sqlalchemy.orm import declarative_base
+
+from app.services.attempt_questions import (
+    matching_question_ids,
+    matching_statement,
+    pool_ids_for,
+    pool_rule,
+)
+
+_Base = declarative_base()
+
+
+class _Paper(_Base):
+    __tablename__ = "stand_in_papers"
+    paper_id = Column(UUID(as_uuid=True), primary_key=True)
+    is_active = Column(Boolean)
+
+
+def _question_model(name: str, with_unit: bool):
+    cols = {
+        "__tablename__": name,
+        "question_id": Column(UUID(as_uuid=True), primary_key=True),
+        "org_id": Column(String),
+        "paper_id": Column(UUID(as_uuid=True)),
+        "subject": Column(String),
+        "chapter": Column(String),
+        "difficulty": Column(String),
+        "question_type": Column(String),
+        "source_type": Column(String),
+    }
+    if with_unit:
+        cols["unit_id"] = Column(String)
+    return type(name.title().replace("_", ""), (_Base,), cols)
+
+
+_QWithUnit = _question_model("stand_in_q_unit", True)
+_QNoUnit = _question_model("stand_in_q_plain", False)
+
+
+def _live(**over):
+    base = {
+        "unit_ids": ["g4-apt-aptitude"],
+        "subjects": ["Aptitude & Mental Ability"],
+        "chapters": ["Percentage"],
+        "difficulty": "medium",
+    }
+    return types.SimpleNamespace(
+        assessment_id="a1",
+        org_id="demo-org",
+        question_ids=ids("keep", 60) + ids("gone", 40),
+        question_count=30,
+        shuffle_questions=True,
+        pool_mode="live",
+        pool_filter={**base, **over},
+    )
+
+
+def _sql(stmt):
+    return str(stmt.compile(dialect=postgresql.dialect()))
+
+
+# ── the rule ─────────────────────────────────────────────────────────────────
+
+def test_a_fixed_paper_has_no_pool_rule():
+    a = _live()
+    a.pool_mode = "fixed"
+    assert pool_rule(a) is None
+    a.pool_mode = None
+    assert pool_rule(a) is None
+
+
+def test_a_live_paper_with_unit_ids_has_a_rule():
+    rule = pool_rule(_live(subjects=None, chapters=None))
+    assert rule["unit_ids"] == ["g4-apt-aptitude"]
+    assert rule["difficulty"] == "medium"
+
+
+def test_subjects_and_chapters_are_compared_in_lower_case():
+    rule = pool_rule(_live(unit_ids=None))
+    assert rule["subjects"] == ["aptitude & mental ability"]
+    assert rule["chapters"] == ["percentage"]
+
+
+def test_a_subject_without_a_chapter_is_too_loose_to_be_a_rule():
+    """Aptitude and Reasoning share a subject, so a subject alone would pull in the wrong unit."""
+    assert pool_rule(_live(unit_ids=None, chapters=None)) is None
+    assert pool_rule(_live(unit_ids=None, subjects=None)) is None
+
+
+def test_a_rule_that_names_nothing_is_no_rule():
+    assert pool_rule(_live(unit_ids=[], subjects=[], chapters=[], paper_ids=None)) is None
+    a = _live()
+    a.pool_filter = "not a dict"
+    assert pool_rule(a) is None
+    a.pool_filter = None
+    assert pool_rule(a) is None
+
+
+def test_an_unknown_difficulty_is_ignored_not_trusted():
+    assert pool_rule(_live(difficulty="medium-ish"))["difficulty"] is None
+    assert pool_rule(_live(difficulty="HARD"))["difficulty"] == "hard"
+
+
+# ── the query ────────────────────────────────────────────────────────────────
+
+def test_a_unit_tagged_question_matches_by_unit_and_an_untagged_one_by_what_it_looks_like():
+    sql = _sql(matching_statement("demo-org", pool_rule(_live()), _QWithUnit, _Paper))
+    assert "stand_in_q_unit.unit_id IN" in sql  # the exact route
+    assert "stand_in_q_unit.unit_id IS NULL" in sql  # untagged questions only get the looks-alike route
+    assert "lower(stand_in_q_unit.subject) IN" in sql
+    assert "lower(stand_in_q_unit.chapter) IN" in sql
+    assert "stand_in_q_unit.org_id =" in sql
+    assert "stand_in_q_unit.difficulty =" in sql
+    assert "LEFT OUTER JOIN stand_in_papers" in sql
+    assert "stand_in_q_unit.paper_id IS NULL" in sql and "stand_in_papers.is_active IS true" in sql
+
+
+def test_the_paper_difficulty_is_part_of_the_match():
+    params = matching_statement("demo-org", pool_rule(_live(difficulty="hard")), _QWithUnit, _Paper).compile(
+        dialect=postgresql.dialect()
+    ).params
+    assert "hard" in params.values()
+    assert "demo-org" in params.values()
+
+    sql = _sql(matching_statement("demo-org", pool_rule(_live(difficulty=None)), _QWithUnit, _Paper))
+    assert "difficulty" not in sql  # any difficulty
+
+
+def test_without_a_unit_column_only_the_looks_alike_route_remains():
+    sql = _sql(matching_statement("demo-org", pool_rule(_live()), _QNoUnit, _Paper))
+    assert "unit_id" not in sql
+    assert "lower(stand_in_q_plain.subject) IN" in sql
+
+
+def test_a_unit_only_rule_selects_nothing_when_questions_carry_no_unit():
+    rule = pool_rule(_live(subjects=None, chapters=None))
+    assert matching_statement("demo-org", rule, _QNoUnit, _Paper) is None
+    assert matching_statement("demo-org", rule, _QWithUnit, _Paper) is not None
+
+
+def test_a_pool_made_of_whole_collections_matches_by_collection():
+    rule = pool_rule(
+        _live(unit_ids=None, subjects=None, chapters=None, difficulty=None, paper_ids=[str(uuid.uuid4())])
+    )
+    sql = _sql(matching_statement("demo-org", rule, _QNoUnit, _Paper))
+    assert "stand_in_q_plain.paper_id IN" in sql
+
+
+# ── resolving a pool ─────────────────────────────────────────────────────────
+
+class _Nested:
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, *exc):
+        return False
+
+
+class _PoolDb(_FakeDb):
+    def __init__(self, rows, fail=False):
+        super().__init__(rows)
+        self.fail = fail
+
+    def begin_nested(self):
+        return _Nested()
+
+    async def execute(self, stmt):
+        if self.fail:
+            raise RuntimeError("column does not exist")
+        return await super().execute(stmt)
+
+
+def test_a_fixed_paper_is_not_asked_of_the_database_at_all():
+    a = _live()
+    a.pool_mode = "fixed"
+    db = _PoolDb([uuid.uuid4()])
+    assert asyncio.run(pool_ids_for(db, a)) == a.question_ids
+    assert db.statements == []
+
+
+def test_new_matches_join_the_stored_questions_after_them():
+    new = [uuid.uuid4() for _ in range(3)]
+    a = _live()
+    got = asyncio.run(pool_ids_for(_PoolDb(new), a))
+    assert got[: len(a.question_ids)] == a.question_ids
+    assert got[len(a.question_ids):] == [str(n) for n in new]
+
+
+def test_a_question_the_paper_already_holds_is_not_added_twice():
+    a = _live()
+    holds = uuid.UUID("00000000-0000-0000-0000-000000000001")
+    a.question_ids = [str(holds), "keep-1"]
+    got = asyncio.run(pool_ids_for(_PoolDb([holds, uuid.uuid4()]), a))
+    assert got.count(str(holds)) == 1
+    assert len(got) == 3
+
+
+def test_a_failing_lookup_leaves_the_paper_as_it_was():
+    a = _live()
+    assert asyncio.run(matching_question_ids(_PoolDb([], fail=True), a)) == []
+    assert asyncio.run(pool_ids_for(_PoolDb([], fail=True), a)) == a.question_ids
+
+
+def test_the_whole_story_a_deleted_collection_and_fifty_new_questions():
+    """A paper of 100 questions, 40 of them from a collection that was then deleted, then 50 uploaded."""
+    a = _live()
+    new = [str(uuid.uuid4()) for _ in range(50)]
+    pool = asyncio.run(pool_ids_for(_PoolDb([uuid.UUID(n) for n in new]), a))
+    assert len(pool) == 150
+
+    live = set(ids("keep", 60)) | set(new)  # the deleted 40 are not live
+    seen_new = set()
+    for _ in range(300):
+        dealt = draw_question_ids(pool, a.question_count, a.shuffle_questions, live)
+        assert len(dealt) == 30
+        assert not any(q.startswith("gone") for q in dealt)  # never a deleted question
+        seen_new.update(q for q in dealt if q in new)
+    assert len(seen_new) > 30  # and the uploaded ones really do get dealt
+
+
+def test_a_paper_whose_questions_all_died_is_usable_again_once_new_ones_arrive():
+    a = _live()
+    a.question_ids = ids("gone", 40)
+    new = [str(uuid.uuid4()) for _ in range(8)]
+    pool = asyncio.run(pool_ids_for(_PoolDb([uuid.UUID(n) for n in new]), a))
+    dealt = draw_question_ids(pool, a.question_count, a.shuffle_questions, set(new))
+    assert sorted(dealt) == sorted(new)
