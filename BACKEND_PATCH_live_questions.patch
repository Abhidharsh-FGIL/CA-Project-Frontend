new file mode 100644
index 0000000..c0b204b
--- /dev/null
+++ b/app/services/attempt_questions.py
@@ -0,0 +1,291 @@
+"""Which questions a student may be dealt — and the ones they must not be.
+
+An assessment keeps a list of question ids, taken when it was created. Two things go wrong with a
+list that is a photograph of the bank:
+
+* A collection that is deleted later is only *retired* (`EvalPaper.is_active = False`): its questions
+  stay in `eval_questions`, and so does every assessment's reference to them. The question bank hides
+  them (its list joins the paper and keeps the active ones); this module applies the same rule to
+  what a student is dealt, so a collection that looks gone in the bank is gone from the tests too.
+
+* A question uploaded later is not in the list, so no attempt can ever draw it. A paper made as a
+  *pool* — "any 30 of the Medium Aptitude questions" — says so (`pool_mode = 'live'`) and states the
+  rule it was made by (`pool_filter`); each attempt is then drawn from the stored list **plus**
+  whatever in the bank matches the rule now.
+
+Both are rules applied when questions are *read*, and nothing is rewritten:
+
+* the assessment's own `question_ids` are left alone, so restoring a collection brings its
+  questions straight back into every paper that held them;
+* an attempt that is finished keeps its questions, so its report still reads as it was sat.
+
+Only two moments change: dealing a **new** attempt, and **resuming** one that is still open.
+"""
+from __future__ import annotations
+
+import logging
+import random
+import uuid
+from typing import Any, Iterable, Optional
+
+log = logging.getLogger(__name__)
+
+LIVE = "live"
+DIFFICULTIES = ("easy", "medium", "hard")
+# A pool is a paper's worth of questions, not a bank. Anything past this is a mis-made filter.
+MAX_POOL = 5000
+
+
+# ── which questions are live ─────────────────────────────────────────────────
+
+async def live_question_ids(db, ids: Iterable[Any]) -> set[str]:
+    """The ids, out of `ids`, a student may be dealt.
+
+    A question is live when it exists and either belongs to no collection (a custom question) or
+    belongs to one that has not been deleted. The same test as the question bank's list.
+    """
+    uuids: list[uuid.UUID] = []
+    for raw in ids:
+        try:
+            uuids.append(uuid.UUID(str(raw)))
+        except ValueError:
+            continue  # not an id at all — never live
+    if not uuids:
+        return set()
+
+    # Imported here, not at the top: the models read settings as they load, and the pure helpers
+    # below (the part with the rules in it) should be usable — and testable — without any of that.
+    from sqlalchemy import or_, select
+
+    from app.models.eval_paper import EvalPaper
+    from app.models.eval_question import EvalQuestion
+
+    rows = await db.execute(
+        select(EvalQuestion.question_id)
+        .outerjoin(EvalPaper, EvalQuestion.paper_id == EvalPaper.paper_id)
+        .where(
+            EvalQuestion.question_id.in_(set(uuids)),
+            or_(EvalQuestion.paper_id.is_(None), EvalPaper.is_active.is_(True)),
+        )
+    )
+    return {str(qid) for qid in rows.scalars().all()}
+
+
+# ── live pools ───────────────────────────────────────────────────────────────
+
+def _strings(value: Any) -> list[str]:
+    if not isinstance(value, (list, tuple)):
+        return []
+    return [str(v).strip() for v in value if v is not None and str(v).strip()]
+
+
+def pool_rule(assessment) -> Optional[dict]:
+    """The rule a live pool is drawn by, or None for a fixed paper.
+
+    None as well when a live paper's rule says nothing a question could match — a pool with no
+    rule has nothing to add, and quietly stays what it was.
+    """
+    if str(getattr(assessment, "pool_mode", None) or "fixed") != LIVE:
+        return None
+    raw = getattr(assessment, "pool_filter", None)
+    if not isinstance(raw, dict):
+        return None
+
+    difficulty = str(raw.get("difficulty") or "").strip().lower()
+    rule = {
+        "unit_ids": _strings(raw.get("unit_ids")),
+        # Compared case-insensitively: "Aptitude" and "aptitude" are the same subject.
+        "subjects": [s.lower() for s in _strings(raw.get("subjects"))],
+        "chapters": [s.lower() for s in _strings(raw.get("chapters"))],
+        "paper_ids": _strings(raw.get("paper_ids")),
+        "difficulty": difficulty if difficulty in DIFFICULTIES else None,
+        "question_types": [s.lower() for s in _strings(raw.get("question_types"))],
+        "source_type": (str(raw.get("source_type")).strip() or None) if raw.get("source_type") else None,
+    }
+    has_membership = bool(rule["unit_ids"] or rule["paper_ids"] or (rule["subjects"] and rule["chapters"]))
+    return rule if has_membership else None
+
+
+def matching_statement(org_id: str, rule: dict, Q, P):
+    """The SELECT of question ids that match a pool rule, or None when the rule cannot select any.
+
+    A question joins the pool when it is live, belongs to the same organisation, is at the paper's
+    difficulty, and is **any** of:
+
+    * tagged to one of the paper's units (`unit_id`) — exact, and what a sheet with a Unit column gets;
+    * not tagged to any unit, but of a subject *and* chapter the paper already holds — the questions
+      an admin adds by hand carry a subject and a topic and no unit, and they are the ones that
+      should look like their neighbours;
+    * in one of the collections the paper was built from.
+
+    `Q` and `P` are the question and collection models (parameters so the rule can be tested against
+    a stand-in). A deployment whose questions have no `unit_id` column simply has no unit clause.
+    """
+    from sqlalchemy import and_, func, or_, select
+
+    unit_col = getattr(Q, "unit_id", None)
+    member: list = []
+
+    if rule["unit_ids"] and unit_col is not None:
+        member.append(unit_col.in_(rule["unit_ids"]))
+
+    if rule["subjects"] and rule["chapters"]:
+        resembles = and_(
+            func.lower(Q.subject).in_(rule["subjects"]),
+            func.lower(Q.chapter).in_(rule["chapters"]),
+        )
+        member.append(and_(unit_col.is_(None), resembles) if unit_col is not None else resembles)
+
+    paper_uuids: list[uuid.UUID] = []
+    for raw in rule["paper_ids"]:
+        try:
+            paper_uuids.append(uuid.UUID(raw))
+        except ValueError:
+            continue
+    if paper_uuids:
+        member.append(Q.paper_id.in_(paper_uuids))
+
+    if not member:
+        return None
+
+    where = [Q.org_id == org_id, or_(Q.paper_id.is_(None), P.is_active.is_(True)), or_(*member)]
+    if rule["difficulty"]:
+        where.append(Q.difficulty == rule["difficulty"])
+    if rule["question_types"]:
+        where.append(Q.question_type.in_(rule["question_types"]))
+    if rule["source_type"]:
+        where.append(Q.source_type == rule["source_type"])
+
+    return select(Q.question_id).outerjoin(P, Q.paper_id == P.paper_id).where(*where)
+
+
+async def matching_question_ids(db, assessment) -> list[str]:
+    """The live bank questions that match this paper's pool rule right now.
+
+    Empty — never an error — for a fixed paper, a rule that selects nothing, or a lookup that
+    fails: a bad rule must leave the paper as it was, not turn it into an empty test.
+    """
+    rule = pool_rule(assessment)
+    if rule is None:
+        return []
+
+    from app.models.eval_paper import EvalPaper
+    from app.models.eval_question import EvalQuestion
+
+    stmt = matching_statement(assessment.org_id, rule, EvalQuestion, EvalPaper)
+    if stmt is None:
+        return []
+    try:
+        # A savepoint, so a failed statement cannot poison the transaction the attempt is made in.
+        async with db.begin_nested():
+            rows = await db.execute(stmt.limit(MAX_POOL))
+        return [str(q) for q in rows.scalars().all()]
+    except Exception:  # noqa: BLE001 — see above
+        log.exception("live pool lookup failed for assessment %s; using its stored questions", assessment.assessment_id)
+        return []
+
+
+async def pool_ids_for(db, assessment) -> list[str]:
+    """Every id this paper can draw from: its stored questions, then the bank's new matches.
+
+    The stored list comes first and keeps its order. For a fixed paper that is all there is.
+    """
+    stored = [str(q) for q in (assessment.question_ids or [])]
+    extra = await matching_question_ids(db, assessment)
+    if not extra:
+        return stored
+    seen = set(stored)
+    return stored + [q for q in extra if q not in seen]
+
+
+# ── dealing ──────────────────────────────────────────────────────────────────
+
+def draw_question_ids(
+    pool: Optional[Iterable[Any]],
+    count: Optional[int],
+    shuffle: bool,
+    live_ids: Optional[set[str]] = None,
+) -> list[str]:
+    """The ordered questions for one new attempt.
+
+    * shuffle: a random sample of `count` from the pool, in random order
+    * otherwise: the first `count` ids (the paper's fixed set), in shuffled order
+
+    With `live_ids`, a question that is not in it is never dealt. A pool that has run short is dealt
+    whole rather than refused — the caller decides what an empty deal means.
+    """
+    ids = [str(q) for q in (pool or [])]
+    if live_ids is not None:
+        ids = [q for q in ids if q in live_ids]
+    n = min(count or len(ids), len(ids))
+
+    if shuffle:
+        return random.sample(ids, n)
+    selected = list(ids[:n])
+    random.shuffle(selected)
+    return selected
+
+
+def prune_dead_questions(
+    dealt: list[str],
+    responses: Optional[list[Any]],
+    live_ids: set[str],
+) -> list[str]:
+    """An open attempt's questions, less the dead ones the student never answered.
+
+    A dead question they *did* answer stays: the answer is theirs, and removing it would change a
+    score they have already earned. One they only looked at goes — they should never have been
+    shown it, and must not be marked down for it.
+    """
+    answered = {
+        str(r.get("question_id"))
+        for r in (responses or [])
+        if isinstance(r, dict) and r.get("answer") not in (None, "", [])
+    }
+    return [q for q in dealt if q in live_ids or q in answered]
+
+
+def top_up_questions(
+    kept: list[str],
+    pool: Optional[Iterable[Any]],
+    live_ids: set[str],
+    target: int,
+) -> list[str]:
+    """`kept`, topped back up to `target` from the pool's live questions it does not already hold.
+
+    So a 30-question paper that lost 5 questions to a deleted collection is still 30 questions —
+    when the pool has the spare — rather than quietly becoming 25.
+    """
+    missing = target - len(kept)
+    if missing <= 0:
+        return list(kept)
+
+    taken = set(kept)
+    spare = [q for q in (str(x) for x in (pool or [])) if q in live_ids and q not in taken]
+    random.shuffle(spare)
+    return list(kept) + spare[:missing]
+
+
+async def refreshed_attempt_questions(db, assessment, attempt, pool: Optional[list[str]] = None) -> list[str]:
+    """The questions a resumed attempt should show now, saved onto the attempt.
+
+    Dead questions the student never answered are dropped and replaced from the paper's pool; the
+    rest keep their place. Nothing changes when nothing is dead.
+    """
+    dealt = [str(q) for q in (attempt.question_ids or [])]
+    pool = pool if pool is not None else await pool_ids_for(db, assessment)
+
+    live = await live_question_ids(db, dealt + pool)
+    kept = prune_dead_questions(dealt, attempt.responses, live)
+    kept = top_up_questions(kept, pool, live, len(dealt))
+
+    if kept != dealt:
+        attempt.question_ids = kept
+        await db.flush()
+    return kept
+
+
+async def pool_report(db, pool: list[str]) -> dict:
+    """What the start response says about the pool — how big it is, how much was skipped as deleted."""
+    live = await live_question_ids(db, pool)
+    return {"pool_size": len(live), "skipped_deleted": len(set(pool) - live)}
diff --git a/scripts/add_pool_columns.sql b/scripts/add_pool_columns.sql
new file mode 100644
index 0000000..a9b3219
--- /dev/null
+++ b/scripts/add_pool_columns.sql
@@ -0,0 +1,81 @@
+-- Live question pools — two columns on assessments, and (optionally) turning existing papers live.
+--
+-- The schema is created with Base.metadata.create_all, which creates missing TABLES and never
+-- adds a column to one that exists, so this is run by hand, once. Safe to re-run.
+--
+--   psql "$DATABASE_URL" -f scripts/add_pool_columns.sql
+--
+-- Part 1 is required. Part 2 is optional and is written to be read before it is run.
+
+-- ── Part 1 — the columns ─────────────────────────────────────────────────────
+
+ALTER TABLE assessments ADD COLUMN IF NOT EXISTS pool_mode   VARCHAR(10) NOT NULL DEFAULT 'fixed';
+ALTER TABLE assessments ADD COLUMN IF NOT EXISTS pool_filter JSON;
+
+
+-- ── Part 2 — papers that already exist (optional) ────────────────────────────
+--
+-- A paper made before this change has no rule, so it stays 'fixed' — only the questions it was
+-- made with, minus any whose collection was deleted. These statements give the single-level unit
+-- papers a rule, so questions added to the bank later reach them.
+--
+-- Which papers: practice papers, shuffled, placed on one or more units, whose title ends in
+-- " · Simple", " · Medium" or " · Complex" (the wizard writes that suffix). NOT touched, because
+-- they are composed sets and not pools: " · Mixed" papers (a 20 / 30 / 50 blend), a section's
+-- " · Full Set", and every mock.
+--
+-- Written for the deployed schema, where assessments has `unit_ids`. The older code base in
+-- D:\GKR\New TNPSC\ca-project has no such column; this does not apply there.
+-- NOT RUN against a real database when it was written — run the preview first, and run the UPDATE
+-- inside BEGIN; ... then ROLLBACK; to look before COMMIT;.
+
+-- 2a. Preview: the papers that would become live.
+SELECT assessment_id,
+       title,
+       question_count                                   AS per_attempt,
+       jsonb_array_length(question_ids::jsonb)          AS stored_questions
+FROM assessments
+WHERE is_active
+  AND mode = 'practice'
+  AND shuffle_questions
+  AND pool_mode = 'fixed'
+  AND unit_ids IS NOT NULL
+  AND jsonb_array_length(unit_ids::jsonb) > 0
+  AND title ~ ' · (Simple|Medium|Complex)$'
+ORDER BY title;
+
+-- 2b. The change.
+-- BEGIN;
+UPDATE assessments a
+SET pool_mode = 'live',
+    pool_filter = json_build_object(
+        'unit_ids', a.unit_ids,
+        'difficulty', CASE
+            WHEN a.title LIKE '% · Simple'  THEN 'easy'
+            WHEN a.title LIKE '% · Complex' THEN 'hard'
+            ELSE 'medium'
+        END,
+        -- What the paper's questions carry today: how a question added by hand, which has no unit,
+        -- recognises the paper it belongs to. Read from the stored questions, so a paper whose
+        -- collection was deleted keeps the rule its questions had.
+        'subjects', (
+            SELECT json_agg(DISTINCT btrim(q.subject))
+            FROM eval_questions q
+            WHERE q.question_id::text IN (SELECT jsonb_array_elements_text(a.question_ids::jsonb))
+              AND q.subject IS NOT NULL AND btrim(q.subject) <> ''
+        ),
+        'chapters', (
+            SELECT json_agg(DISTINCT btrim(q.chapter))
+            FROM eval_questions q
+            WHERE q.question_id::text IN (SELECT jsonb_array_elements_text(a.question_ids::jsonb))
+              AND q.chapter IS NOT NULL AND btrim(q.chapter) <> ''
+        )
+    )
+WHERE a.is_active
+  AND a.mode = 'practice'
+  AND a.shuffle_questions
+  AND a.pool_mode = 'fixed'
+  AND a.unit_ids IS NOT NULL
+  AND jsonb_array_length(a.unit_ids::jsonb) > 0
+  AND a.title ~ ' · (Simple|Medium|Complex)$';
+-- COMMIT;   -- or ROLLBACK; if the preview was not what you expected
