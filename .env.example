# Copy this file to .env and fill in the values.

# FastAPI backend base URL — no trailing slash.
# Dev:  http://localhost:8000
# Prod: https://your-domain.com/api-prefix
VITE_API_BASE_URL=https://app.genverse.ai/api/

# Google OAuth client ID, for "Sign in with Google" on the login and sign-up pages.
# Google Cloud console -> APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#   -> Application type "Web application". Add every address the app is served from under
#   "Authorized JavaScript origins" (e.g. http://localhost:5173 and https://mygovexams.com).
# It looks like 1234567890-abcdefg.apps.googleusercontent.com. It is public, but still set it here and
# not in the code. The client SECRET is never needed in the frontend. Leave empty to turn Google sign-in off.
VITE_GOOGLE_CLIENT_ID=
